# ==============================================================
# Langkawi Tour & Travel - Stripe Payment Gateway Environment Variables
# ==============================================================
# NOTE: Never commit actual secret keys to Git!
# Enter these keys in your Cloudflare Dashboard (Workers & Pages > Settings > Environment Variables)
# Or create a local ".dev.vars" file when testing with Wrangler locally.

# 1. Stripe Live Secret Key
# Get your Secret Key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# 2. Your Live Website URL (Optional - defaults to request origin)
# Used for payment redirect return URLs
SITE_URL=https://langkawitravelntour.com
