# ==============================================================
# Langkawi Tour & Travel - Payment Gateway Environment Variables
# ==============================================================
# NOTE: Never commit actual secret keys to Git!
# Enter these keys in your Cloudflare Dashboard (Workers / Pages > Settings > Environment Variables)
# Or create a local ".dev.vars" file when testing with Wrangler locally.

# 1. Stripe Live Credentials
# Get your Secret Key from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# 2. ToyyibPay Live Credentials
# Get your User Secret Key from: https://toyyibpay.com (Settings > User Profile)
TOYYIBPAY_SECRET_KEY=your_toyyibpay_user_secret_key_here

# Get your Category Code from: https://toyyibpay.com (Category > Add Category)
TOYYIBPAY_CATEGORY_CODE=your_8_char_category_code_here

# Set environment: "production" for live, "sandbox" for dev.toyyibpay.com
TOYYIBPAY_ENV=production

# 3. Your Live Website URL
# Used for payment redirect return URLs
SITE_URL=https://langkawitravelntour.com
